# Required for the admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional. If omitted, a persistent key is created in DATA_DIR/admin_session.key
SECRET_KEY=
# Keep 1 when serving over HTTPS. Set 0 only for local HTTP development.
COOKIE_SECURE=1
# Existing bot settings
DISCORD_TOKEN=
SPIDE_COOKIE=
PORT=3000
DATA_DIR=.
